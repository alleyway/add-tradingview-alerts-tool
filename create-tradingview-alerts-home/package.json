{
  "name": "@alleyway/create-tradingview-alerts-home",
  "version": "1.12.0",
  "license": "MIT",
  "engines": {
    "node": "26.13"
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "bin": {
    "create-tradingview-alerts-home": "/dist/index.js"
  },
  "scripts": {
    "build": "pnpm exec tsc && mkdir -p dist/init && cp src/init/* dist/init/",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm exec release-it minor --no-git --verbose",
    "release-beta": "pnpm exec release-it prerelease --no-git --verbose --preReleaseId='beta'"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "release-it": "^19.2.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "kleur": "^4.1.5",
    "prompts": "^2.4.1"
  }
}