{
  "name": "@alleyway/add-tradingview-alerts-tool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alleyway/add-tradingview-alerts-tool.git"
  },
  "bugs": {
    "url": "https://github.com/alleyway/add-tradingview-alerts-tool/issues"
  },
  "description": "Add TradingView Alerts in bulk",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "atat": "dist/cli.js"
  },
  "files": [
    "src",
    "dist",
    "tsconfig.json",
    "!**/*.test.**"
  ],
  "scripts": {
    "build": "npx tsc",
    "atat": "node --no-warnings ./dist/cli.js",
    "prepublishOnly": "npm run build",
    "release": "echo 'MAKE SURE YOU RUN ./deploy_master.sh first! and DO NOT PUBLISH FROM HERE!' && npx release-it",
    "release-beta": "echo 'MAKE SURE to TAG your beta for github actions to deploy npm package!!' && npx release-it --preRelease=beta --config .release-it.beta-nopublish.json",
    "prepare": "husky",
    "postinstall": "npx @puppeteer/browsers install chrome@stable",
    "test": "rm -Rf ./user_data && node --experimental-vm-modules --trace-warnings node_modules/.bin/vitest run",
    "test:ci": "rm -Rf ./user_data && node --experimental-vm-modules --trace-warnings node_modules/.bin/vitest run --coverage.enabled",
    "test:watch": "vitest --watch",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "ci": "biome ci"
  },
  "keywords": [
    "tradingview",
    "alerts",
    "3commas",
    "indicator"
  ],
  "author": "Michael Lake",
  "license": "MIT",
  "version": "4.1.6",
  "dependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "commander": "^15.0.0",
    "consola": "^3.2.3",
    "dotenv": "^18.0.9",
    "extensionless": "^2.0.6",
    "fast-csv": "^5.0.8",
    "kleur": "^4.1.5",
    "lodash.get": "^4.4.2",
    "pacote": "^22.0.1",
    "puppeteer-core": "^25.16.0",
    "regex-parser": "^2.3.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@release-it/bumper": "^8.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "husky": "^9.1.7",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "private": false
}